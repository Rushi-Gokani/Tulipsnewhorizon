  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'scrolling.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'events.js' | asset_url }}"
  fetchpriority="low"
>

{% comment %} CORE SCRIPTS - Load these first but still deferred {% endcomment %}
<script type="module" fetchpriority="low">
  // Dynamically import only what's needed immediately
  const modulesToLoad = [
    import('{{ "popover-polyfill.js" | asset_url }}'),
    import('{{ "overflow-list.js" | asset_url }}'),
    import('{{ "dialog.js" | asset_url }}'),
    import('{{ "component-quantity-selector.js" | asset_url }}')
  ];

  // Load product-form early as it's critical
  import('{{ "product-form.js" | asset_url }}');
  
  {% if template == 'product' or template.name == 'product' or request.page_type == 'product' %}
    import('{{ "variant-picker.js" | asset_url }}');
    import('{{ "media-gallery.js" | asset_url }}');
    {% if settings.transition_to_main_product %}
      import('{{ "product-card-link.js" | asset_url }}');
    {% endif %}
  {% endif %}
</script>

{% comment %} DEFERRED NON-CRITICAL SCRIPTS {% endcomment %}
<script type="module" fetchpriority="low">
  // Load after page is interactive
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => {
      loadDeferredModules();
    }, { timeout: 3000 });
  } else {
    setTimeout(loadDeferredModules, 3000);
  }
  
  function loadDeferredModules() {
    {% if settings.quick_add or settings.mobile_quick_add %}
      import('{{ "quick-add.js" | asset_url }}');
    {% endif %}
    
    {% if settings.show_add_discount_code %}
      import('{{ "cart-discount.js" | asset_url }}');
    {% endif %}
    
    import('{{ "product-card.js" | asset_url }}');
    import('{{ "product-price.js" | asset_url }}');
    import('{{ "product-title-truncation.js" | asset_url }}');
    import('{{ "accordion-custom.js" | asset_url }}');
    import('{{ "media.js" | asset_url }}');
    import('{{ "show-more.js" | asset_url }}');
    import('{{ "floating-panel.js" | asset_url }}');
    import('{{ "anchored-popover.js" | asset_url }}');
    import('{{ "rte-formatter.js" | asset_url }}');
    
    {% if template == 'product' or template.name == 'product' or request.page_type == 'product' %}
      import('{{ "product-sku.js" | asset_url }}');
      import('{{ "product-inventory.js" | asset_url }}');
      import('{{ "volume-pricing.js" | asset_url }}');
      import('{{ "price-per-item.js" | asset_url }}');
      import('{{ "volume-pricing-info.js" | asset_url }}');
      
      // Load heavy product page scripts last
      requestIdleCallback(() => {
        import('{{ "sticky-add-to-cart.js" | asset_url }}');
        import('{{ "fly-to-cart.js" | asset_url }}');
      }, { timeout: 5000 });
    {% endif %}
    
    // Load slideshows only if they exist on page
    if (document.querySelector('slideshow-component, layered-slideshow')) {
      import('{{ "slideshow.js" | asset_url }}');
      import('{{ "layered-slideshow.js" | asset_url }}');
    }
    
    // Load video background only if present
    if (document.querySelector('video-background')) {
      import('{{ "video-background.js" | asset_url }}');
    }
    
    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
      import('{{ "localization.js" | asset_url }}');
    {% endif %}
  }
</script>

{% comment %} NON-MODULE SCRIPTS - Keep deferred {% endcomment %}
<script
  src="{{ 'simple-product-card.js' | asset_url }}"
  defer="defer"
></script>
<script
  src="{{ 'auto-close-details.js' | asset_url }}"
  defer="defer"
></script>

{% if template == 'product' or template.name == 'product' or request.page_type == 'product' %}
  <script type="module">
    // Delay recently viewed to not block product rendering
    requestIdleCallback(() => {
      import('@theme/recently-viewed-products').then(({ RecentlyViewed }) => {
        RecentlyViewed.addProduct('{{ product.id }}');
      });
    }, { timeout: 4000 });
  </script>
{% endif %}

