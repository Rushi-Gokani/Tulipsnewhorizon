{%- comment -%}
  Product Slider — pulls slides from a product's `custom.product_slider` metafield
  (list of `product_slider_item` metaobject references). Hides entirely if the
  product has no slides assigned. See the setup guide for metaobject/metafield
  creation steps — those are store-level data model configuration and can't be
  created from theme files.
{%- endcomment -%}

{{ 'product-slider.css' | asset_url | stylesheet_tag }}

{%- if product and product.metafields.custom.product_slider.value.size > 0 -%}
  {%- assign slides = product.metafields.custom.product_slider.value -%}
  {%- assign widths = '375,550,750,1100,1500' | split: ',' -%}

  <product-slider-component
    class="product-slider color-{{ section.settings.color_scheme }}"
    data-autoplay="{{ section.settings.enable_autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 | times: 1000 }}"
    data-infinite="{{ section.settings.enable_infinite_loop }}"
    style="
      --product-slider-radius: 16px;
      --product-slider-spv-desktop: {{ section.settings.slides_per_view_desktop }};
      --product-slider-spv-tablet: {{ section.settings.slides_per_view_tablet }};
      --product-slider-spv-mobile: {{ section.settings.slides_per_view_mobile }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.background_color != blank %}
        background-color: {{ section.settings.background_color }};
      {% endif %}
    "
  >
    <div class="product-slider__section">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="product-slider__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-slider__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="product-slider__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-slider__viewport" ref="viewport">
        <ul class="product-slider__track" ref="track" role="list">
          {%- for slide in slides -%}
            {%- liquid
              assign heading = slide.heading.value
              assign description = slide.description.value
              assign button_text = slide.button_text.value
              assign button_url = slide.button_url.value
              assign image = slide.image.value
            -%}
            <li
              class="product-slider__slide"
              ref="slides[]"
              role="listitem"
              aria-roledescription="slide"
              aria-label="Slide {{ forloop.index }} of {{ forloop.length }}"
            >
              <div class="product-slider__card product-slider__card--image-{{ section.settings.image_position }}">
                <div class="product-slider__card-media product-slider__card-media--{{ section.settings.image_aspect_ratio }}">
                  {%- if image != blank -%}
                    <img
                      src="{{ image | image_url: width: 750 }}"
                      srcset="
                        {%- for w in widths -%}
                          {{ image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{% endunless %}
                        {%- endfor -%}
                      "
                      sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                      alt="{{ image.alt | default: heading | escape }}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      loading="lazy"
                      class="product-slider__image"
                    >
                  {%- endif -%}
                </div>

                <div class="product-slider__card-content">
                  {%- if heading != blank -%}
                    <h3 class="product-slider__card-heading">{{ heading }}</h3>
                  {%- endif -%}
                  {%- if description != blank -%}
                    <div class="product-slider__card-description">{{ description }}</div>
                  {%- endif -%}
                  {%- if button_text != blank and button_url != blank -%}
                    <a
                      href="{{ button_url }}"
                      class="product-slider__button product-slider__button--{{ section.settings.button_style }}"
                    >
                      {{- button_text -}}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if section.settings.show_arrows -%}
        <button
          type="button"
          class="product-slider__arrow product-slider__arrow--prev"
          ref="prevButton"
          aria-label="Previous slide"
          on:click="/goToPrevious"
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
        <button
          type="button"
          class="product-slider__arrow product-slider__arrow--next"
          ref="nextButton"
          aria-label="Next slide"
          on:click="/goToNext"
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
      {%- endif -%}

      {%- if section.settings.show_dots and slides.size > 1 -%}
        <div class="product-slider__dots" ref="dots" role="tablist" aria-label="Slide navigation">
          {%- for slide in slides -%}
            <button
              type="button"
              class="product-slider__dot"
              ref="dots[]"
              role="tab"
              aria-label="Go to slide {{ forloop.index }}"
              on:click="/goToSlide/{{ forloop.index0 }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <script src="{{ 'product-slider.js' | asset_url }}" type="module" fetchpriority="low"></script>
  </product-slider-component>
{%- endif -%}

{% schema %}
{
  "name": "Product slider",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to use the color scheme's background."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "Desktop slides per view",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "slides_per_view_tablet",
      "label": "Tablet slides per view",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "slides_per_view_mobile",
      "label": "Mobile slides per view",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_loop",
      "label": "Enable infinite loop",
      "default": true
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "left", "label": "Left" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    }
  ]
}
{% endschema %}
