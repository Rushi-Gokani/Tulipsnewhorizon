{{ 'section-featured-collection-carousel.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'"/>
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/></noscript>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .featured-collection-carousel-section {
    background-color: {{ section.settings.bg_color }};
  }

  /* Tabs Styles - Capsule/Pill Button */
  .collection-tabs-wrapper {
    margin-bottom: 30px;
  }

  .collection-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .collection-tab {
    border: 2px solid #e0e0e0;
    background: #ffffff;
    padding: 12px 28px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    color: {{ section.settings.tab_text_color }};
    border-radius: 50px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .collection-tab:hover {
    border-color: {{ section.settings.tab_active_color }};
    color: {{ section.settings.tab_active_color }};
    background: #f8f8f8;
  }

  .collection-tab.active {
    background: {{ section.settings.tab_active_color }};
    color: #ffffff;
    border-color: {{ section.settings.tab_active_color }};
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  /* Performance: Hide non-active tab contents completely */
  .tab-content:not(.active) {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .collection-tabs {
      gap: 8px;
    }

    .collection-tab {
      padding: 10px 20px;
      font-size: 14px;
    }

    .featured-collection-carousel-section .title-wrapper-with-link {
      text-align: center;
    }

    .featured-collection-carousel-section .title {
      text-align: center;
    }
  }

  .product-judgeme-reviews {
    margin-bottom: 10px;
    min-height: 20px;
  }

  .featured-collection-carousel-slider--centralized .jdgm-widget,
  .featured-collection-carousel-slider--centralized .card-info {
    text-align: left;
  }

  .featured-collection-carousel-slider {
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .featured-collection-carousel-slider.swiper-initialized {
    opacity: 1;
  }

  /* Fallback styles before Swiper initializes */
  .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
  }

  .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% / 2.1) - 10px);
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-wrapper {
      gap: 20px;
    }
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc((100% / 2.5) - 20px);
    }
  }

  @media screen and (min-width: 990px) {
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-wrapper {
      gap: 30px;
    }
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc((100% / {{ section.settings.desktop_columns }}) - 30px);
    }
  }
{%- endstyle -%}

<div class="featured-collection-carousel-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin centered">
        <h2 class="title {{ section.settings.heading_size }} center">
          {{ section.settings.title | escape }}
        </h2>
      </div>
    {%- endif -%}

    {%- assign source_collection = collections[section.settings.collection] -%}
    {%- if source_collection == blank -%}
      {%- assign source_collection = collection -%}
    {%- endif -%}

    <!-- Build tabs data -->
    {%- capture tab_list -%}
      {%- for i in (1..5) -%}
        {%- case i -%}
          {%- when 1 -%}{%- assign setting_key = 'first' -%}
          {%- when 2 -%}{%- assign setting_key = 'second' -%}
          {%- when 3 -%}{%- assign setting_key = 'third' -%}
          {%- when 4 -%}{%- assign setting_key = 'fourth' -%}
          {%- when 5 -%}{%- assign setting_key = 'fifth' -%}
        {%- endcase -%}

        {%- assign tab_collection = collections[section.settings[setting_key]] -%}
        {%- if tab_collection == blank and source_collection != blank -%}
          {%- assign tab_collection = source_collection.metafields.custom[setting_key].value -%}
        {%- endif -%}

        {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
          <li class="collection-tab {% if forloop.index == 1 %}active{% endif %}"
              role="tab"
              data-tab-index="{{ forloop.index }}"
              data-tab-id="tab-{{ section.id }}-{{ i }}"
              data-collection-id="{{ tab_collection.id }}">
            {{ tab_collection.title | escape }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <!-- Tab Navigation -->
    {%- if tab_list != blank -%}
      <div class="collection-tabs-wrapper">
        <ul class="collection-tabs" role="tablist">
          {{ tab_list }}
        </ul>
      </div>
    {%- endif -%}

    <!-- Tab Contents - Only first tab has product markup, others lazy load via JS -->
    {%- assign tab_index = 0 -%}
    {%- for i in (1..5) -%}
      {%- case i -%}
        {%- when 1 -%}{%- assign setting_key = 'first' -%}
        {%- when 2 -%}{%- assign setting_key = 'second' -%}
        {%- when 3 -%}{%- assign setting_key = 'third' -%}
        {%- when 4 -%}{%- assign setting_key = 'fourth' -%}
        {%- when 5 -%}{%- assign setting_key = 'fifth' -%}
      {%- endcase -%}

      {%- assign tab_collection = collections[section.settings[setting_key]] -%}
      {%- if tab_collection == blank and source_collection != blank -%}
        {%- assign tab_collection = source_collection.metafields.custom[setting_key].value -%}
      {%- endif -%}

      {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
        {%- assign tab_index = tab_index | plus: 1 -%}
        {%- assign is_active = false -%}
        {%- if tab_index == 1 -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        {%- assign tab_id = 'tab-' | append: section.id | append: '-' | append: i -%}

        <div class="tab-content {% if is_active %}active{% endif %}"
             id="{{ tab_id }}"
             data-tab-id="{{ tab_id }}"
             data-collection-handle="{{ tab_collection.handle }}"
             {% unless is_active %}data-lazy="true"{% endunless %}>

          {%- if is_active -%}
            <!-- Pre-render first tab content for immediate display -->
            <div class="featured-collection-carousel-slider swiper{% if section.settings.centralize_products %} featured-collection-carousel-slider--centralized{% endif %}"
                 data-slider-container="true">
              <div class="swiper-wrapper">
                {%- assign limit = section.settings.products_to_show -%}
                {%- if section.settings.show_all_products -%}
                  {%- assign limit = 50 -%}
                {%- endif -%}
                {%- for product in tab_collection.products limit: limit -%}
                  <div class="swiper-slide">
                    {% capture product_content %}
                      {% capture gallery_children %}
                        <div class="product-badges product-badges--top-left">
                          {%- if product.compare_at_price > product.price -%}
                            {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                            <div class="product-badges__badge product-badges__badge--custom">
                              {{ discount }}% OFF
                            </div>
                          {%- endif -%}
                          {%- if product.available == false -%}
                            <div class="product-badges__badge product-badges__badge--custom">
                              SOLD OUT
                            </div>
                          {%- endif -%}
                        </div>
                      {% endcapture %}

                      {% render 'card-gallery', product: product, children: gallery_children %}
                      <div class="card-info" style="padding: 15px;">
                        <h3 class="card-title h5" style="margin: 0 0 5px;">
                          <a href="{{ product.url | within: tab_collection }}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                            {{ product.title }}
                          </a>
                        </h3>
                        {%- assign review_block = section.blocks | where: 'type', 'judgeme_reviews' | first -%}
                        {%- if review_block -%}
                          <div class="product-judgeme-reviews" {{ review_block.shopify_attributes }}>
                            <div class='jdgm-widget jdgm-preview-badge' 
                                 data-id='{{ product.id }}'
                                 {% unless review_block.settings.show_text %}data-nometa='true'{% endunless %}>
                              {{ product.metafields.judgeme.badge }}
                            </div>
                          </div>
                        {%- endif -%}

                        {%- for block in section.blocks -%}
                          {%- if block.type == 'custom_liquid' -%}
                            <div class="product-custom-liquid" {{ block.shopify_attributes }}>
                              {{ block.settings.custom_liquid }}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}

                        <div style="margin-bottom: 15px;">
                          {% render 'price', product_resource: product, show_compare_price: true %}
                        </div>
                        {% render 'product-card-button', product: product %}
                      </div>
                    {% endcapture %}

                    {% render 'product-card',
                      product: product,
                      children: product_content
                    %}
                  </div>
                {%- else -%}
                  <div class="swiper-slide" style="text-align: center; padding: 40px;">
                    <p>{{ 'sections.featured_collection.no_products' | t }}</p>
                  </div>
                {%- endfor -%}
              </div>

              {%- if section.settings.show_arrows -%}
                <div class="featured-collection-controls">
                  <div class="swiper-button-prev">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="swiper-button-next">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- else -%}
            <!-- Lazy loaded tabs - empty container, will be populated on demand -->
            <div class="featured-collection-carousel-slider swiper{% if section.settings.centralize_products %} featured-collection-carousel-slider--centralized{% endif %}"
                 data-slider-container="true"
                 data-lazy-load="true">
              <div class="swiper-wrapper">
                <!-- Products will be loaded via AJAX when tab becomes active -->
                <div class="swiper-slide" style="text-align: center; padding: 40px;">
                  <div class="loading-spinner" style="display: flex; justify-content: center; align-items: center; min-height: 200px;">
                    <svg width="40" height="40" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="3" fill="currentColor"/>
                    </svg>
                  </div>
                </div>
              </div>
              {%- if section.settings.show_arrows -%}
                <div class="featured-collection-controls">
                  <div class="swiper-button-prev">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="swiper-button-next">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <!-- Fallback: Single collection if no tabs -->
    {%- if tab_list == blank and section.settings.collection != blank -%}
      <div class="featured-collection-carousel-slider swiper{% if section.settings.centralize_products %} featured-collection-carousel-slider--centralized{% endif %}"
           data-slider-container="true"
           data-fallback="true">
        <div class="swiper-wrapper">
          {%- assign limit = section.settings.products_to_show -%}
          {%- if section.settings.show_all_products -%}
            {%- assign limit = 50 -%}
          {%- endif -%}
          {%- for product in section.settings.collection.products limit: limit -%}
            <div class="swiper-slide">
              {% capture product_content %}
                {% capture gallery_children %}
                  <div class="product-badges product-badges--top-left">
                    {%- if product.compare_at_price > product.price -%}
                      {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                      <div class="product-badges__badge product-badges__badge--custom">
                        {{ discount }}% OFF
                      </div>
                    {%- endif -%}
                    {%- if product.available == false -%}
                      <div class="product-badges__badge product-badges__badge--custom">
                        SOLD OUT
                      </div>
                    {%- endif -%}
                  </div>
                {% endcapture %}

                {% render 'card-gallery', product: product, children: gallery_children %}
                <div class="card-info" style="padding: 15px;">
                  <h3 class="card-title h5" style="margin: 0 0 5px;">
                    <a href="{{ product.url | within: section.settings.collection }}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                      {{ product.title }}
                    </a>
                  </h3>
                  {%- assign review_block = section.blocks | where: 'type', 'judgeme_reviews' | first -%}
                  {%- if review_block -%}
                    <div class="product-judgeme-reviews" {{ review_block.shopify_attributes }}>
                      <div class='jdgm-widget jdgm-preview-badge' 
                           data-id='{{ product.id }}'
                           {% unless review_block.settings.show_text %}data-nometa='true'{% endunless %}>
                        {{ product.metafields.judgeme.badge }}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- for block in section.blocks -%}
                    {%- if block.type == 'custom_liquid' -%}
                      <div class="product-custom-liquid" {{ block.shopify_attributes }}>
                        {{ block.settings.custom_liquid }}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                  <div style="margin-bottom: 15px;">
                    {% render 'price', product_resource: product, show_compare_price: true %}
                  </div>
                  {% render 'product-card-button', product: product %}
                </div>
              {% endcapture %}

              {% render 'product-card',
                product: product,
                children: product_content
              %}
            </div>
          {%- else -%}
            <div class="swiper-slide" style="text-align: center; padding: 40px;">
              <p>{{ 'sections.featured_collection.no_products' | t }}</p>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.show_arrows -%}
          <div class="featured-collection-controls">
            <div class="swiper-button-prev">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="swiper-button-next">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- schema -%}
{
  "name": "Featured Collection Slide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured collection",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Tab Collections"
    },
    {
      "type": "collection",
      "id": "first",
      "label": "First Tab Collection"
    },
    {
      "type": "collection",
      "id": "second",
      "label": "Second Tab Collection"
    },
    {
      "type": "collection",
      "id": "third",
      "label": "Third Tab Collection"
    },
    {
      "type": "collection",
      "id": "fourth",
      "label": "Fourth Tab Collection"
    },
    {
      "type": "collection",
      "id": "fifth",
      "label": "Fifth Tab Collection"
    },
    {
      "type": "header",
      "content": "Tab Styling"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Tab Active Color",
      "default": "#a3ca6d"
    },
    {
      "type": "header",
      "content": "Fallback Collection (no tabs)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show per tab"
    },
    {
      "type": "checkbox",
      "id": "show_all_products",
      "label": "Show all products (max 50)",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 5,
      "unit": "s",
      "label": "Autoplay speed (slide duration)"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "centralize_products",
      "label": "Centralize products",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection Slide"
    }
  ],
  "blocks": [
    {
      "type": "judgeme_reviews",
      "name": "Judge.me Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "This block will show Judge.me review stars and text for each product. Best practices: Ensure Judge.me app is installed."
        },
        {
          "type": "checkbox",
          "id": "show_text",
          "label": "Show review text",
          "default": true
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ]
}
{%- endschema -%}

<script>
(function() {
  'use strict';

  const sectionId = '{{ section.id }}';
  const autoplayDelay = {{ section.settings.autoplay_speed | times: 1000 }};
  const desktopColumns = {{ section.settings.desktop_columns | json }};
  const centralizeProducts = {{ section.settings.centralize_products | json }};
  const showArrows = {{ section.settings.show_arrows | json }};

  // Store Swiper instances
  const swiperInstances = new Map();
  // Track loaded lazy tabs
  const loadedTabs = new Set();

  // Helper: Initialize Swiper on a slider element
  function initSwiper(sliderElement, startAutoplay = true) {
    if (!sliderElement || sliderElement.classList.contains('swiper-initialized')) {
      return null;
    }

    const swiperConfig = {
      slidesPerView: 2.1,
      spaceBetween: 10,
      loop: false,
      rewind: true,
      centeredSlides: centralizeProducts,
      observer: true,
      observeParents: true,
      updateOnWindowResize: true,
      centerInsufficientSlides: centralizeProducts,
      autoplay: startAutoplay ? {
        delay: autoplayDelay,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      } : false,
      breakpoints: {
        750: {
          slidesPerView: 2.5,
          spaceBetween: 20,
        },
        990: {
          slidesPerView: desktopColumns,
          spaceBetween: 30,
        }
      }
    };

    // Only add navigation if arrows are enabled and buttons exist
    if (showArrows) {
      const nextBtn = sliderElement.querySelector('.swiper-button-next');
      const prevBtn = sliderElement.querySelector('.swiper-button-prev');
      if (nextBtn && prevBtn) {
        swiperConfig.navigation = {
          nextEl: nextBtn,
          prevEl: prevBtn
        };
      }
    }

    try {
      const swiper = new Swiper(sliderElement, swiperConfig);
      sliderElement.style.opacity = '1';
      return swiper;
    } catch (e) {
      console.warn('Swiper initialization failed:', e);
      return null;
    }
  }

  // Helper: Load products for a lazy tab via AJAX
  async function loadTabProducts(tabContent, collectionHandle) {
    if (!collectionHandle || loadedTabs.has(tabContent.id)) {
      return;
    }

    const sliderContainer = tabContent.querySelector('[data-slider-container="true"]');
    if (!sliderContainer) return;

    // Show loading state
    const wrapper = sliderContainer.querySelector('.swiper-wrapper');
    if (wrapper) {
      wrapper.innerHTML = `
        <div class="swiper-slide" style="text-align: center; padding: 40px;">
          <div class="loading-spinner" style="display: flex; justify-content: center; align-items: center; min-height: 200px;">
            <svg width="40" height="40" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="3" fill="currentColor"/>
            </svg>
          </div>
        </div>
      `;
    }

    try {
      const limit = {{ section.settings.products_to_show | json }};
      const response = await fetch(`/collections/${collectionHandle}/products.json?limit=${limit}`);
      const data = await response.json();

      if (data.products && data.products.length > 0) {
        // Build product slides HTML
        let slidesHtml = '';
        for (const product of data.products) {
          const comparePrice = product.variants[0]?.compare_at_price || product.compare_at_price;
          const price = product.variants[0]?.price || product.price;
          const discount = comparePrice && comparePrice > price ? Math.round(((comparePrice - price) / comparePrice) * 100) : null;
          
          slidesHtml += `
            <div class="swiper-slide">
              <div class="product-card-wrapper">
                <div class="card-gallery-wrapper">
                  <a href="/products/${product.handle}" class="card-gallery__link">
                    <div class="card-gallery__media">
                      <img src="${product.images[0]?.src || ''}" alt="${product.title.replace(/"/g, '&quot;')}" loading="lazy" width="300" height="300">
                    </div>
                  </a>
                  ${discount ? `<div class="product-badges product-badges--top-left"><div class="product-badges__badge">${discount}% OFF</div></div>` : ''}
                </div>
                <div class="card-info" style="padding: 15px;">
                  <h3 class="card-title h5" style="margin: 0 0 5px;">
                    <a href="/products/${product.handle}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                      ${product.title}
                    </a>
                  </h3>
                  <div style="margin-bottom: 15px;">
                    <div class="price">
                      <span class="price-item price-item--regular">${formatMoney(price)}</span>
                      ${comparePrice && comparePrice > price ? `<span class="price-item price-item--sale price-item--compare">${formatMoney(comparePrice)}</span>` : ''}
                    </div>
                  </div>
                  <button class="button button--primary button--add-to-cart" data-product-id="${product.variants[0]?.id}" data-product-handle="${product.handle}">Add to Cart</button>
                </div>
              </div>
            </div>
          `;
        }
        if (wrapper) {
          wrapper.innerHTML = slidesHtml;
        }
        loadedTabs.add(tabContent.id);
      } else {
        if (wrapper) {
          wrapper.innerHTML = '<div class="swiper-slide" style="text-align: center; padding: 40px;"><p>No products found.</p></div>';
        }
      }

      // Initialize Swiper after content load
      setTimeout(() => {
        const swiper = initSwiper(sliderContainer, true);
        if (swiper) {
          swiperInstances.set(tabContent.id, swiper);
        }
      }, 50);

    } catch (error) {
      console.warn('Failed to load tab products:', error);
      if (wrapper) {
        wrapper.innerHTML = '<div class="swiper-slide" style="text-align: center; padding: 40px;"><p>Error loading products. Please try again.</p></div>';
      }
    }
  }

  // Helper: Format money
  function formatMoney(cents) {
    if (typeof cents !== 'number') return '$0.00';
    return '$' + (cents / 100).toFixed(2);
  }

  // Initialize all active sliders on page load
  function initializeActiveSliders() {
    const activeTab = document.querySelector('.tab-content.active');
    if (activeTab) {
      const activeSlider = activeTab.querySelector('[data-slider-container="true"]');
      if (activeSlider && !activeSlider.classList.contains('swiper-initialized')) {
        const swiper = initSwiper(activeSlider, true);
        if (swiper) {
          swiperInstances.set(activeTab.id, swiper);
        }
      }
    }
  }

  // Tab click handler with lazy loading
  function setupTabHandlers() {
    const tabs = document.querySelectorAll('.collection-tab');
    const section = document.querySelector(`.featured-collection-carousel-section[data-section-id="${sectionId}"]`);

    if (!section) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', async function(e) {
        e.preventDefault();

        const tabId = this.getAttribute('data-tab-id');
        if (!tabId) return;

        const currentActiveTab = section.querySelector('.collection-tab.active');
        const currentActiveContent = section.querySelector('.tab-content.active');
        const newActiveContent = section.querySelector(`#${tabId}`);

        if (currentActiveTab === this && newActiveContent === currentActiveContent) {
          return;
        }

        // Stop autoplay on current slider
        if (currentActiveContent && swiperInstances.has(currentActiveContent.id)) {
          const currentSwiper = swiperInstances.get(currentActiveContent.id);
          if (currentSwiper && currentSwiper.autoplay) {
            currentSwiper.autoplay.stop();
          }
        }

        // Update active classes
        section.querySelectorAll('.collection-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        section.querySelectorAll('.tab-content').forEach(content => {
          content.classList.remove('active');
        });

        const targetContent = section.querySelector(`#${tabId}`);
        if (targetContent) {
          targetContent.classList.add('active');

          const slider = targetContent.querySelector('[data-slider-container="true"]');

          // Check if this is a lazy-loaded tab
          if (targetContent.dataset.lazy === 'true' && !loadedTabs.has(tabId)) {
            const collectionHandle = targetContent.dataset.collectionHandle;
            if (collectionHandle) {
              await loadTabProducts(targetContent, collectionHandle);
            }
          } else if (slider && !slider.classList.contains('swiper-initialized')) {
            // Initialize Swiper if not already done
            const swiper = initSwiper(slider, true);
            if (swiper) {
              swiperInstances.set(tabId, swiper);
            }
          } else if (slider && swiperInstances.has(tabId)) {
            // Restart autoplay for existing Swiper
            const existingSwiper = swiperInstances.get(tabId);
            if (existingSwiper && existingSwiper.autoplay) {
              setTimeout(() => {
                existingSwiper.autoplay.start();
              }, 100);
            }
          }
        }
      });
    });
  }

  // Initialize everything when DOM is ready
  function init() {
    initializeActiveSliders();
    setupTabHandlers();

    // Handle window resize and orientation change
    const handleResize = () => {
      setTimeout(() => {
        swiperInstances.forEach(swiper => {
          if (swiper && swiper.update) {
            swiper.update();
          }
        });
      }, 200);
    };

    window.addEventListener('resize', handleResize);
    window.addEventListener('orientationchange', handleResize);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>