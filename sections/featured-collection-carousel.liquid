{{ 'section-featured-collection-carousel.css' | asset_url | stylesheet_tag }}

<!-- Ultra Optimized Swiper - Async load -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="preload" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" /></noscript>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" async></script>

<!-- Critical CSS - Inlined for speed -->
<style>
  /* Critical styles - no layout shift */
  .featured-collection-carousel-section{background-color:{{ section.settings.bg_color }}}
  .collection-tabs-wrapper{margin-bottom:30px}
  .collection-tabs{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;list-style:none;padding:0;margin:0}
  .collection-tab{border:2px solid #e0e0e0;background:#fff;padding:12px 28px;cursor:pointer;font-size:15px;font-weight:500;color:{{ section.settings.tab_text_color }};border-radius:50px;transition:all .3s ease;white-space:nowrap}
  .collection-tab.active{background:{{ section.settings.tab_active_color }};color:#fff;border-color:{{ section.settings.tab_active_color }}}
  .tab-content{display:none}
  .tab-content.active{display:block}
  .featured-collection-carousel-slider{overflow:hidden;position:relative;width:100%}
  .featured-collection-carousel-slider .swiper-wrapper{display:flex}
  .featured-collection-carousel-slider .swiper-slide{height:auto;flex-shrink:0;width:calc((100% / 4) - 20px);margin-right:20px}
  @media (max-width:640px){.featured-collection-carousel-slider .swiper-slide{width:calc((100% / 2) - 10px);margin-right:10px}}
  @media (min-width:641px) and (max-width:767px){.featured-collection-carousel-slider .swiper-slide{width:calc((100% / 2.5) - 15px);margin-right:15px}}
  @media (min-width:768px) and (max-width:1023px){.featured-collection-carousel-slider .swiper-slide{width:calc((100% / 3) - 20px);margin-right:20px}}
  .featured-collection-carousel-slider .swiper-button-prev,.featured-collection-carousel-slider .swiper-button-next{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;background:#A8D02A;border-radius:50%;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center;transition:all .3s ease}
  .featured-collection-carousel-slider .swiper-button-prev{left:5px}
  .featured-collection-carousel-slider .swiper-button-next{right:5px}
  .featured-collection-carousel-slider .swiper-button-prev svg,.featured-collection-carousel-slider .swiper-button-next svg{width:20px;height:20px;stroke:#333}
  @media (max-width:768px){.featured-collection-carousel-slider .swiper-button-prev,.featured-collection-carousel-slider .swiper-button-next{width:36px;height:36px}}
  .featured-collection-carousel-slider.single-item .swiper-button-prev,.featured-collection-carousel-slider.single-item .swiper-button-next{display:none}
  .product-card{height:100%;display:flex;flex-direction:column;background:#fff;border-radius:8px;overflow:hidden}
  .card-gallery{width:100%;aspect-ratio:1/1;overflow:hidden;background:#f5f5f5}
  .card-gallery__media{width:100%;height:100%}
  .card-gallery__media img{width:100%;height:100%;object-fit:cover}
  .card-info{padding:15px;flex:1;display:flex;flex-direction:column}
  .card-title{margin:0 0 5px;font-size:14px;line-height:1.3;min-height:36px}
  .price{margin-bottom:12px;min-height:40px}
  .product-card-button{margin-top:auto}
  .button--add-to-cart{width:100%;padding:10px 12px}
  .product-badges{position:absolute;top:10px;left:10px;z-index:2}
  .product-badges__badge--custom{background:#ff4444;color:#fff;padding:4px 10px;border-radius:4px;font-size:12px;font-weight:bold}
  .section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top | times:0.75 | round:0 }}px;padding-bottom:{{ section.settings.padding_bottom | times:0.75 | round:0 }}px}
  @media (min-width:750px){.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}
</style>

<div class="featured-collection-carousel-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin centered">
        <h2 class="title {{ section.settings.heading_size }} center">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}

    {%- assign source_collection = collections[section.settings.collection] -%}
    {%- if source_collection == blank -%}
      {%- assign source_collection = collection -%}
    {%- endif -%}

    <!-- Build tabs - Minimal HTML -->
    {%- capture tab_list -%}
      {%- for i in (1..5) -%}
        {%- case i -%}
          {%- when 1 -%}{%- assign setting_key = 'first' -%}
          {%- when 2 -%}{%- assign setting_key = 'second' -%}
          {%- when 3 -%}{%- assign setting_key = 'third' -%}
          {%- when 4 -%}{%- assign setting_key = 'fourth' -%}
          {%- when 5 -%}{%- assign setting_key = 'fifth' -%}
        {%- endcase -%}
        {%- assign tab_collection = collections[section.settings[setting_key]] -%}
        {%- if tab_collection == blank and source_collection != blank -%}
          {%- assign tab_collection = source_collection.metafields.custom[setting_key].value -%}
        {%- endif -%}
        {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
          <li class="collection-tab {% if forloop.index == 1 %}active{% endif %}" data-tab-id="tab-{{ section.id }}-{{ i }}">{{ tab_collection.title | escape }}</li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if tab_list != blank -%}
      <div class="collection-tabs-wrapper"><ul class="collection-tabs">{{ tab_list }}</ul></div>
    {%- endif -%}

    <!-- Tab Contents -->
    {%- assign tab_index = 0 -%}
    {%- for i in (1..5) -%}
      {%- case i -%}
        {%- when 1 -%}{%- assign setting_key = 'first' -%}
        {%- when 2 -%}{%- assign setting_key = 'second' -%}
        {%- when 3 -%}{%- assign setting_key = 'third' -%}
        {%- when 4 -%}{%- assign setting_key = 'fourth' -%}
        {%- when 5 -%}{%- assign setting_key = 'fifth' -%}
      {%- endcase -%}
      {%- assign tab_collection = collections[section.settings[setting_key]] -%}
      {%- if tab_collection == blank and source_collection != blank -%}
        {%- assign tab_collection = source_collection.metafields.custom[setting_key].value -%}
      {%- endif -%}
      {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
        {%- assign tab_index = tab_index | plus: 1 -%}
        {%- assign tab_id = 'tab-' | append: section.id | append: '-' | append: i -%}
        {%- assign product_count = tab_collection.products_count -%}
        {%- assign is_active = false -%}
        {%- if tab_index == 1 -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        {%- assign single_class = '' -%}
        {%- if product_count == 1 -%}
          {%- assign single_class = 'single-item' -%}
        {%- endif -%}
        
        <div class="tab-content {% if is_active %}active{% endif %}" id="{{ tab_id }}" data-product-count="{{ product_count }}">
          <div class="featured-collection-carousel-slider swiper {{ single_class }}" data-product-count="{{ product_count }}">
            <div class="swiper-wrapper">
              {%- assign limit = section.settings.products_to_show -%}
              {%- if section.settings.show_all_products -%}{%- assign limit = 50 -%}{%- endif -%}
              {%- for product in tab_collection.products limit: limit -%}
                <div class="swiper-slide">
                  {% capture product_card_content %}
                    {% capture gallery_children %}
                      <div class="product-badges product-badges--top-left">
                        {%- if product.compare_at_price > product.price -%}
                          {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                          <div class="product-badges__badge product-badges__badge--custom">{{ discount }}% OFF</div>
                        {%- endif -%}
                        {%- if product.available == false -%}
                          <div class="product-badges__badge product-badges__badge--custom">SOLD OUT</div>
                        {%- endif -%}
                      </div>
                    {% endcapture %}
                    {% render 'card-gallery', product: product, children: gallery_children %}
                    <div class="card-info" style="padding:15px">
                      <h3 class="card-title h5" style="margin:0 0 5px"><a href="{{ product.url | within: tab_collection }}" class="full-unstyled-link" style="text-decoration:none;color:inherit">{{ product.title }}</a></h3>
                      {%- assign review_block = section.blocks | where: 'type', 'judgeme_reviews' | first -%}
                      {%- if review_block -%}
                        <div class="product-judgeme-reviews" {{ review_block.shopify_attributes }}>
                          <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' {% unless review_block.settings.show_text %}data-nometa='true'{% endunless %}>{{ product.metafields.judgeme.badge }}</div>
                        </div>
                      {%- endif -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'custom_liquid' -%}
                          <div class="product-custom-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
                        {%- endif -%}
                      {%- endfor -%}
                      <div style="margin-bottom:15px">{% render 'price', product_resource: product, show_compare_price: true %}</div>
                      {% render 'product-card-button', product: product %}
                    </div>
                  {% endcapture %}
                  {% render 'product-card', product: product, children: product_card_content %}
                </div>
              {%- else -%}
                <div class="swiper-slide" style="text-align:center;padding:40px"><p>No products found.</p></div>
              {%- endfor -%}
            </div>
            <div class="swiper-button-prev"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div class="swiper-button-next"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <!-- Fallback -->
    {%- if tab_list == blank and section.settings.collection != blank -%}
      {%- assign fallback_count = section.settings.collection.products_count -%}
      {%- assign fallback_class = '' -%}
      {%- if fallback_count == 1 -%}
        {%- assign fallback_class = 'single-item' -%}
      {%- endif -%}
      <div class="featured-collection-carousel-slider swiper {{ fallback_class }}" data-product-count="{{ fallback_count }}">
        <div class="swiper-wrapper">
          {%- assign limit = section.settings.products_to_show -%}
          {%- if section.settings.show_all_products -%}{%- assign limit = 50 -%}{%- endif -%}
          {%- for product in section.settings.collection.products limit: limit -%}
            <div class="swiper-slide">
              {% capture product_card_content %}
                {% capture gallery_children %}
                  <div class="product-badges product-badges--top-left">
                    {%- if product.compare_at_price > product.price -%}
                      {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                      <div class="product-badges__badge product-badges__badge--custom">{{ discount }}% OFF</div>
                    {%- endif -%}
                    {%- if product.available == false -%}
                      <div class="product-badges__badge product-badges__badge--custom">SOLD OUT</div>
                    {%- endif -%}
                  </div>
                {% endcapture %}
                {% render 'card-gallery', product: product, children: gallery_children %}
                <div class="card-info" style="padding:15px">
                  <h3 class="card-title h5" style="margin:0 0 5px"><a href="{{ product.url | within: section.settings.collection }}" class="full-unstyled-link" style="text-decoration:none;color:inherit">{{ product.title }}</a></h3>
                  {%- assign review_block = section.blocks | where: 'type', 'judgeme_reviews' | first -%}
                  {%- if review_block -%}
                    <div class="product-judgeme-reviews" {{ review_block.shopify_attributes }}>
                      <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' {% unless review_block.settings.show_text %}data-nometa='true'{% endunless %}>{{ product.metafields.judgeme.badge }}</div>
                    </div>
                  {%- endif -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'custom_liquid' -%}
                      <div class="product-custom-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
                    {%- endif -%}
                  {%- endfor -%}
                  <div style="margin-bottom:15px">{% render 'price', product_resource: product, show_compare_price: true %}</div>
                  {% render 'product-card-button', product: product %}
                </div>
              {% endcapture %}
              {% render 'product-card', product: product, children: product_card_content %}
            </div>
          {%- else -%}
            <div class="swiper-slide" style="text-align:center;padding:40px"><p>No products found.</p></div>
          {%- endfor -%}
        </div>
        <div class="swiper-button-prev"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div class="swiper-button-next"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- Optimized JavaScript -->
<script>
(function(){
  const desktopCols = {{ section.settings.desktop_columns | default: 4 }};
  const autoplaySpeed = {{ section.settings.autoplay_speed }};
  let swipers = [];
  
  function initSlider(slider){
    if(slider.swiper) return;
    var count = parseInt(slider.dataset.productCount);
    if(count === 1){
      slider.classList.add('single-item');
      slider.swiper = new Swiper(slider,{slidesPerView:1,spaceBetween:0,loop:false,autoplay:false,centeredSlides:true,allowTouchMove:false});
      return;
    }
    var config = {
      slidesPerView:2,
      spaceBetween:15,
      speed:300,
      grabCursor:true,
      autoplay: autoplaySpeed>0 ? {delay:autoplaySpeed*1000,disableOnInteraction:false} : false,
      breakpoints:{
        0:{slidesPerView:2,spaceBetween:10},
        640:{slidesPerView:2.5,spaceBetween:15},
        768:{slidesPerView:3,spaceBetween:20},
        1024:{slidesPerView:desktopCols,spaceBetween:25}
      },
      navigation:{nextEl:slider.querySelector('.swiper-button-next'),prevEl:slider.querySelector('.swiper-button-prev')}
    };
    slider.swiper = new Swiper(slider,config);
    swipers.push(slider.swiper);
  }
  
  function initSliders(){
    document.querySelectorAll('.featured-collection-carousel-slider').forEach(initSlider);
  }
  
  function initTabs(){
    document.querySelectorAll('.collection-tab').forEach(function(tab){
      tab.addEventListener('click',function(e){
        e.preventDefault();
        var tabId = tab.dataset.tabId;
        if(!tabId) return;
        var section = tab.closest('.featured-collection-carousel-section');
        var newContent = section.querySelector('#' + tabId);
        if(!newContent || section.querySelector('.tab-content.active') === newContent) return;
        section.querySelectorAll('.collection-tab').forEach(function(t){ t.classList.remove('active'); });
        tab.classList.add('active');
        section.querySelectorAll('.tab-content').forEach(function(c){ c.classList.remove('active'); });
        newContent.classList.add('active');
        var newSlider = newContent.querySelector('.featured-collection-carousel-slider');
        if(newSlider && !newSlider.swiper) setTimeout(function(){ initSlider(newSlider); },10);
      });
    });
  }
  
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){ initSliders(); initTabs(); });
  else { initSliders(); initTabs(); }
  window.addEventListener('resize',function(){ swipers.forEach(function(s){ if(s && s.update) s.update(); }); });
})();
</script>

{% schema %}
{
  "name": "Featured Collection Slide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured collection",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Tab Collections"
    },
    {
      "type": "collection",
      "id": "first",
      "label": "First Tab Collection"
    },
    {
      "type": "collection",
      "id": "second",
      "label": "Second Tab Collection"
    },
    {
      "type": "collection",
      "id": "third",
      "label": "Third Tab Collection"
    },
    {
      "type": "collection",
      "id": "fourth",
      "label": "Fourth Tab Collection"
    },
    {
      "type": "collection",
      "id": "fifth",
      "label": "Fifth Tab Collection"
    },
    {
      "type": "header",
      "content": "Tab Styling"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Tab Active Color",
      "default": "#a3ca6d"
    },
    {
      "type": "header",
      "content": "Fallback Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Products per tab"
    },
    {
      "type": "checkbox",
      "id": "show_all_products",
      "label": "Show all products",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 5,
      "unit": "s",
      "label": "Autoplay speed"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "centralize_products",
      "label": "Center products",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection Slide"
    }
  ],
  "blocks": [
    {
      "type": "judgeme_reviews",
      "name": "Judge.me Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_text",
          "label": "Show review text",
          "default": true
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ]
}
{% endschema %}