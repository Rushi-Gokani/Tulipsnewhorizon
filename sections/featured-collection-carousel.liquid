      "min": 0,
      "max": 30,
      "step": 1,
      "default": 5,
      "unit": "s",
      "label": "Autoplay speed"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "centralize_products",
      "label": "Center products",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection Slide"
    }
  ],
  "blocks": [
    {
      "type": "judgeme_reviews",
      "name": "Judge.me Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_text",
