{{ 'section-featured-collection-carousel.css' | asset_url | stylesheet_tag }}

<!-- Performance Optimized Swiper Loading -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preload" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"></noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .featured-collection-carousel-section {
    background-color: {{ section.settings.bg_color }};
  }

  /* Tabs Styles - Capsule/Pill Button */
  .collection-tabs-wrapper {
    margin-bottom: 30px;
  }

  .collection-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .collection-tab {
    border: 2px solid #e0e0e0;
    background: #ffffff;
    padding: 12px 28px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    color: {{ section.settings.tab_text_color }};
    border-radius: 50px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .collection-tab:hover {
    border-color: {{ section.settings.tab_active_color }};
    color: {{ section.settings.tab_active_color }};
    background: #f8f8f8;
  }

  .collection-tab.active {
    background: {{ section.settings.tab_active_color }};
    color: #ffffff;
    border-color: {{ section.settings.tab_active_color }};
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .collection-tabs {
      gap: 8px;
    }

    .collection-tab {
      padding: 10px 20px;
      font-size: 14px;
    }

    .featured-collection-carousel-section .title-wrapper-with-link {
      text-align: center;
    }

    .featured-collection-carousel-section .title {
      text-align: center;
    }
  }

  .product-judgeme-reviews {
    margin-bottom: 10px;
    min-height: 20px;
  }

  .featured-collection-carousel-slider--centralized .jdgm-widget,
  .featured-collection-carousel-slider--centralized .card-info {
    text-align: left;
  }

  .featured-collection-carousel-slider {
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .featured-collection-carousel-slider.swiper-initialized {
    opacity: 1;
  }

  .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
  }

  .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% / 2.1) - 10px);
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-wrapper {
      gap: 20px;
    }
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc((100% / 2.5) - 20px);
    }
  }

  @media screen and (min-width: 990px) {
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-wrapper {
      gap: 30px;
    }
    .featured-collection-carousel-slider:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc((100% / {{ section.settings.desktop_columns }}) - 30px);
    }
  }

  /* Performance optimizations */
  .featured-collection-carousel-section img {
    content-visibility: auto;
    contain: paint;
  }

  .featured-collection-carousel-section .swiper-slide {
    will-change: transform;
  }
{%- endstyle -%}

<div class="featured-collection-carousel-section section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin centered">
        <h2 class="title {{ section.settings.heading_size }} center">
          {{ section.settings.title | escape }}
        </h2>
      </div>
    {%- endif -%}
    

    <!-- Tabs Navigation -->
    {%- assign source_collection = collections[section.settings.collection] -%}
    {%- if source_collection == blank -%}
      {%- assign source_collection = collection -%}
    {%- endif -%}

    {% assign show_tabs = false %}
    {% for i in (1..5) %}
      {% case i %}
        {% when 1 %}{% assign setting_key = 'first' %}
        {% when 2 %}{% assign setting_key = 'second' %}
        {% when 3 %}{% assign setting_key = 'third' %}
        {% when 4 %}{% assign setting_key = 'fourth' %}
        {% when 5 %}{% assign setting_key = 'fifth' %}
      {% endcase %}

      {%- assign tab_collection = collections[section.settings[setting_key]] -%}
      {%- if tab_collection == blank and source_collection != blank -%}
        {%- assign tab_collection = source_collection.metafields.custom[setting_key].value -%}
      {%- endif -%}

      {% if tab_collection != blank %}
        {% assign show_tabs = true %}
      {% endif %}
    {% endfor %}

    {% if show_tabs %}
      <div class="collection-tabs-wrapper">
        <ul class="collection-tabs" role="tablist">
          {% assign tab_index = 0 %}
          {% for i in (1..5) %}
            {% case i %}
              {% when 1 %}{% assign setting_key = 'first' %}
              {% when 2 %}{% assign setting_key = 'second' %}
              {% when 3 %}{% assign setting_key = 'third' %}
              {% when 4 %}{% assign setting_key = 'fourth' %}
              {% when 5 %}{% assign setting_key = 'fifth' %}
            {% endcase %}

            {%- assign tab_collection = collections[section.settings[setting_key]] -%}
            {%- if tab_collection == blank and source_collection != blank -%}
              {%- assign tab_collection = source_collection.metafields.custom[setting_key].value -%}
            {%- endif -%}

            {% if tab_collection != blank %}
              {% assign tab_index = tab_index | plus: 1 %}
              <li class="collection-tab {% if tab_index == 1 %}active{% endif %}"
                  role="tab"
                  data-tab="tab-{{ section.id }}-{{ i }}"
                  data-collection="{{ tab_collection.id }}">
                {{ tab_collection.title }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <!-- Tab Contents -->
    {% assign tab_content_index = 0 %}
    {% for i in (1..5) %}
      {% case i %}
        {% when 1 %}{% assign setting_key = 'first' %}
        {% when 2 %}{% assign setting_key = 'second' %}
        {% when 3 %}{% assign setting_key = 'third' %}
        {% when 4 %}{% assign setting_key = 'fourth' %}
        {% when 5 %}{% assign setting_key = 'fifth' %}
      {% endcase %}

      {%- assign tab_collection = collections[section.settings[setting_key]] -%}
      {%- if tab_collection == blank and source_collection != blank -%}
        {%- assign tab_collection = source_collection.metafields.custom[setting_key].value -%}
      {%- endif -%}

      {% if tab_collection != blank %}
        {% assign tab_content_index = tab_content_index | plus: 1 %}

        <div class="tab-content {% if tab_content_index == 1 %}active{% endif %}"
             id="tab-{{ section.id }}-{{ i }}"
             data-tab-content="tab-{{ section.id }}-{{ i }}">

          <div class="featured-collection-carousel-slider swiper{% if section.settings.centralize_products %} featured-collection-carousel-slider--centralized{% endif %}"
               data-tab-id="tab-{{ section.id }}-{{ i }}"
               data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}"
               data-desktop-columns="{{ section.settings.desktop_columns }}"
               data-centralize="{{ section.settings.centralize_products | json }}">
            <div class="swiper-wrapper">
              {%- assign limit = section.settings.products_to_show -%}
              {%- if section.settings.show_all_products -%}
                {%- assign limit = 50 -%}
              {%- endif -%}
              {%- for product in tab_collection.products limit: limit -%}
                <div class="swiper-slide">
                  {% capture product_card_content %}
                    {% capture gallery_children %}
                      <div class="product-badges product-badges--top-left">
                        {%- if product.compare_at_price > product.price -%}
                          {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                          <div class="product-badges__badge product-badges__badge--custom">
                            {{ discount }}% OFF
                          </div>
                        {%- endif -%}
                        {%- if product.available == false -%}
                          <div class="product-badges__badge product-badges__badge--custom">
                            SOLD OUT
                          </div>
                        {%- endif -%}
                      </div>
                    {% endcapture %}

                    {% render 'card-gallery', product: product, children: gallery_children %}
                    <div class="card-info" style="padding: 15px;">
                      <h3 class="card-title h5" style="margin: 0 0 5px;">
                        <a href="{{ product.url | within: tab_collection }}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                          {{ product.title }}
                        </a>
                      </h3>
                      {%- assign review_block = section.blocks | where: 'type', 'judgeme_reviews' | first -%}
                      {%- if review_block -%}
                        <div class="product-judgeme-reviews" {{ review_block.shopify_attributes }}>
                          <div class='jdgm-widget jdgm-preview-badge' 
                               data-id='{{ product.id }}'
                               {% unless review_block.settings.show_text %}data-nometa='true'{% endunless %}>
                            {{ product.metafields.judgeme.badge }}
                          </div>
                        </div>
                      {%- endif -%}

                      {%- for block in section.blocks -%}
                        {%- if block.type == 'custom_liquid' -%}
                          <div class="product-custom-liquid" {{ block.shopify_attributes }}>
                            {{ block.settings.custom_liquid }}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}

                      <div style="margin-bottom: 15px;">
                        {% render 'price', product_resource: product, show_compare_price: true %}
                      </div>
                      {% render 'product-card-button', product: product %}
                    </div>
                  {% endcapture %}

                  {% render 'product-card',
                    product: product,
                    children: product_card_content
                  %}
                </div>
              {%- else -%}
                <div class="swiper-slide" style="text-align: center; padding: 40px;">
                  <p>No products found in this collection.</p>
                </div>
              {%- endfor -%}
            </div>

            {% if section.settings.show_arrows %}
              <div class="featured-collection-controls">
                <div class="swiper-button-prev">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div class="swiper-button-next">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    <!-- Fallback: Single collection if no tabs -->
    {% if show_tabs == false and section.settings.collection != blank %}
      <div class="featured-collection-carousel-slider swiper{% if section.settings.centralize_products %} featured-collection-carousel-slider--centralized{% endif %}"
           data-autoplay-delay="{{ section.settings.autoplay_speed | times: 1000 }}"
           data-desktop-columns="{{ section.settings.desktop_columns }}"
           data-centralize="{{ section.settings.centralize_products | json }}">
        <div class="swiper-wrapper">
          {%- assign limit = section.settings.products_to_show -%}
          {%- if section.settings.show_all_products -%}
            {%- assign limit = 50 -%}
          {%- endif -%}
          {%- for product in section.settings.collection.products limit: limit -%}
            <div class="swiper-slide">
              {% capture product_card_content %}
                {% capture gallery_children %}
                  <div class="product-badges product-badges--top-left">
                    {%- if product.compare_at_price > product.price -%}
                      {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                      <div class="product-badges__badge product-badges__badge--custom">
                        {{ discount }}% OFF
                      </div>
                    {%- endif -%}
                    {%- if product.available == false -%}
                      <div class="product-badges__badge product-badges__badge--custom">
                        SOLD OUT
                      </div>
                    {%- endif -%}
                  </div>
                {% endcapture %}

                {% render 'card-gallery', product: product, children: gallery_children %}
                <div class="card-info" style="padding: 15px;">
                  <h3 class="card-title h5" style="margin: 0 0 5px;">
                    <a href="{{ product.url | within: section.settings.collection }}" class="full-unstyled-link" style="text-decoration: none; color: inherit;">
                      {{ product.title }}
                    </a>
                  </h3>
                  {%- assign review_block = section.blocks | where: 'type', 'judgeme_reviews' | first -%}
                  {%- if review_block -%}
                    <div class="product-judgeme-reviews" {{ review_block.shopify_attributes }}>
                      <div class='jdgm-widget jdgm-preview-badge' 
                           data-id='{{ product.id }}'
                           {% unless review_block.settings.show_text %}data-nometa='true'{% endunless %}>
                        {{ product.metafields.judgeme.badge }}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- for block in section.blocks -%}
                    {%- if block.type == 'custom_liquid' -%}
                      <div class="product-custom-liquid" {{ block.shopify_attributes }}>
                        {{ block.settings.custom_liquid }}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                  <div style="margin-bottom: 15px;">
                    {% render 'price', product_resource: product, show_compare_price: true %}
                  </div>
                  {% render 'product-card-button', product: product %}
                </div>
              {% endcapture %}

              {% render 'product-card',
                product: product,
                children: product_card_content
              %}
            </div>
          {%- endfor -%}
        </div>

        {% if section.settings.show_arrows %}
          <div class="featured-collection-controls">
            <div class="swiper-button-prev">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="swiper-button-next">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<!-- Optimized JavaScript -->
<script>
(function() {
  'use strict';
  
  var swiperInstances = {};
  var pendingInitializations = [];
  var isSwiperLoading = false;
  var swiperLoaded = false;
  var swiperCallbacks = [];
  
  // Load Swiper asynchronously
  function loadSwiper(callback) {
    if (swiperLoaded && typeof Swiper !== 'undefined') {
      callback();
      return;
    }
    
    swiperCallbacks.push(callback);
    
    if (isSwiperLoading) return;
    isSwiperLoading = true;
    
    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
    script.async = true;
    script.defer = true;
    script.onload = function() {
      swiperLoaded = true;
      isSwiperLoading = false;
      swiperCallbacks.forEach(function(cb) { cb(); });
      swiperCallbacks = [];
    };
    script.onerror = function() {
      isSwiperLoading = false;
      console.warn('Failed to load Swiper, retrying...');
      setTimeout(function() {
        loadSwiper(swiperCallbacks[0]);
      }, 1000);
    };
    document.body.appendChild(script);
  }
  
  // Initialize a single Swiper instance
  function initSwiper(slider, isActive) {
    if (!slider || slider.swiperInitialized) return null;
    
    var autoplayDelay = parseInt(slider.dataset.autoplayDelay) || 5000;
    var desktopColumns = parseFloat(slider.dataset.desktopColumns) || 4;
    var centralize = slider.dataset.centralize === 'true';
    
    var swiperConfig = {
      slidesPerView: 2.1,
      spaceBetween: 10,
      loop: false,
      rewind: true,
      centeredSlides: false,
      observer: true,
      observeParents: true,
      updateOnWindowResize: true,
      centerInsufficientSlides: centralize,
      navigation: {
        nextEl: slider.querySelector('.swiper-button-next'),
        prevEl: slider.querySelector('.swiper-button-prev'),
      },
      breakpoints: {
        750: {
          slidesPerView: 2.5,
          spaceBetween: 20,
        },
        990: {
          slidesPerView: desktopColumns,
          spaceBetween: 30,
        }
      },
      on: {
        init: function() {
          slider.swiperInitialized = true;
          slider.style.opacity = '1';
        }
      }
    };
    
    // Only add autoplay for active tabs
    if (isActive && autoplayDelay > 0) {
      swiperConfig.autoplay = {
        delay: autoplayDelay,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      };
    }
    
    try {
      return new Swiper(slider, swiperConfig);
    } catch(e) {
      console.warn('Failed to initialize Swiper:', e);
      return null;
    }
  }
  
  // Initialize visible carousels with staggered timing
  function initVisibleCarousels() {
    var sliders = document.querySelectorAll('.featured-collection-carousel-slider');
    var activeSliders = [];
    var inactiveSliders = [];
    
    sliders.forEach(function(slider) {
      var tabContent = slider.closest('.tab-content');
      var isActive = tabContent && tabContent.classList.contains('active');
      
      if (isActive) {
        activeSliders.push(slider);
      } else {
        inactiveSliders.push(slider);
      }
    });
    
    // Initialize active sliders first with small delays
    activeSliders.forEach(function(slider, index) {
      setTimeout(function() {
        var tabContent = slider.closest('.tab-content');
        var isActive = tabContent && tabContent.classList.contains('active');
        var tabId = tabContent ? tabContent.id : 'default';
        
        if (!swiperInstances[tabId]) {
          swiperInstances[tabId] = initSwiper(slider, isActive);
        }
      }, index * 50);
    });
    
    // Mark inactive sliders for lazy initialization
    inactiveSliders.forEach(function(slider) {
      var tabContent = slider.closest('.tab-content');
      if (tabContent) {
        tabContent.dataset.needsInit = 'true';
      }
    });
  }
  
  // Tab click handler with lazy initialization
  function initTabs() {
    var tabs = document.querySelectorAll('.collection-tab');
    
    tabs.forEach(function(tab) {
      tab.removeEventListener('click', tab._clickHandler);
      
      tab._clickHandler = function(e) {
        var tabId = this.getAttribute('data-tab');
        var section = this.closest('.featured-collection-carousel-section');
        
        if (!section) return;
        
        // Stop all autoplay
        section.querySelectorAll('.tab-content').forEach(function(content) {
          var swiper = swiperInstances[content.id];
          if (swiper && swiper.autoplay && swiper.autoplay.stop) {
            swiper.autoplay.stop();
          }
        });
        
        // Update active classes
        section.querySelectorAll('.collection-tab').forEach(function(t) {
          t.classList.remove('active');
        });
        section.querySelectorAll('.tab-content').forEach(function(content) {
          content.classList.remove('active');
        });
        
        this.classList.add('active');
        var tabContent = section.querySelector('[data-tab-content="' + tabId + '"]');
        
        if (tabContent) {
          tabContent.classList.add('active');
          
          var swiper = swiperInstances[tabId];
          var slider = tabContent.querySelector('.featured-collection-carousel-slider');
          
          // Initialize Swiper if not already done
          if (!swiper && slider) {
            loadSwiper(function() {
              setTimeout(function() {
                swiperInstances[tabId] = initSwiper(slider, true);
              }, 10);
            });
          } else if (swiper && swiper.update) {
            requestAnimationFrame(function() {
              swiper.update();
              if (swiper.autoplay && swiper.autoplay.start) {
                swiper.autoplay.start();
              }
            });
          }
        }
      };
      
      tab.addEventListener('click', tab._clickHandler);
    });
  }
  
  // Debounced resize handler
  var resizeTimeout;
  function handleResize() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      Object.values(swiperInstances).forEach(function(swiper) {
        if (swiper && swiper.update && typeof swiper.update === 'function') {
          swiper.update();
        }
      });
    }, 150);
  }
  
  // Handle orientation change
  function handleOrientationChange() {
    setTimeout(function() {
      Object.values(swiperInstances).forEach(function(swiper) {
        if (swiper && swiper.update) {
          swiper.update();
        }
      });
    }, 100);
  }
  
  // Initialize everything
  function initialize() {
    loadSwiper(function() {
      // Small delay to ensure DOM is ready
      setTimeout(function() {
        initVisibleCarousels();
        initTabs();
        window.addEventListener('resize', handleResize);
        window.addEventListener('orientationchange', handleOrientationChange);
      }, 50);
    });
  }
  
  // Start initialization when ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
})();
</script>

{% schema %}
{
  "name": "Featured Collection Slide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured collection",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Tab Collections"
    },
    {
      "type": "collection",
      "id": "first",
      "label": "First Tab Collection"
    },
    {
      "type": "collection",
      "id": "second",
      "label": "Second Tab Collection"
    },
    {
      "type": "collection",
      "id": "third",
      "label": "Third Tab Collection"
    },
    {
      "type": "collection",
      "id": "fourth",
      "label": "Fourth Tab Collection"
    },
    {
      "type": "collection",
      "id": "fifth",
      "label": "Fifth Tab Collection"
    },
    {
      "type": "header",
      "content": "Tab Styling"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Tab Active Color",
      "default": "#a3ca6d"
    },
    {
      "type": "header",
      "content": "Fallback Collection (no tabs)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show per tab"
    },
    {
      "type": "checkbox",
