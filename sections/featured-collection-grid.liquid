{{ 'section-featured-collection-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .featured-collection-grid-section {
    background-color: {{ section.settings.bg_color }};
    --fcg-desktop-cols: {{ section.settings.desktop_columns | default: 4 }};
  }
{%- endstyle -%}

<div class="featured-collection-grid-section section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin centered">
        <h2 class="title {{ section.settings.heading_size }} center">
          {{ section.settings.title | escape }}
        </h2>
      </div>
    {%- endif -%}

    {%- assign source_collection = collections[section.settings.collection] -%}
    {%- if source_collection != blank -%}
      {%- assign limit = section.settings.products_to_show -%}
      {%- if section.settings.show_all_products -%}
        {%- assign limit = 50 -%}
      {%- endif -%}

      <div class="featured-collection-grid">
        {%- for product in source_collection.products limit: limit -%}
          {% capture product_card_content %}
            {% capture gallery_children %}
              <div class="product-badges product-badges--top-left">
                {%- if product.compare_at_price > product.price -%}
                  {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                  <div class="product-badges__badge product-badges__badge--custom">
                    {{ discount }}% OFF
                  </div>
                {%- endif -%}
                {%- if product.available == false -%}
                  <div class="product-badges__badge product-badges__badge--custom" style="background: #999;">
                    SOLD OUT
                  </div>
                {%- endif -%}
              </div>
            {% endcapture %}

            {% render 'card-gallery', product: product, children: gallery_children %}
            <div class="card-info">
              <h3 class="card-title h5">
                <a href="{{ product.url | within: source_collection }}" class="full-unstyled-link">
                  {{ product.title }}
                </a>
              </h3>
              {%- assign review_block = section.blocks | where: 'type', 'judgeme_reviews' | first -%}
              {%- if review_block -%}
                <div class="product-judgeme-reviews" {{ review_block.shopify_attributes }}>
                  <div class='jdgm-widget jdgm-preview-badge'
                       data-id='{{ product.id }}'
                       {% unless review_block.settings.show_text %}data-nometa='true'{% endunless %}>
                    {{ product.metafields.judgeme.badge }}
                  </div>
                </div>
              {%- endif -%}

              {%- for block in section.blocks -%}
                {%- if block.type == 'custom_liquid' -%}
                  <div class="product-custom-liquid" {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>
                {%- endif -%}
              {%- endfor -%}

              <div class="price">
                {% render 'price', product_resource: product, show_compare_price: true %}
                <p class="mrp-tax">MRP Inclusive of All Taxes</p>

              </div>
              <div class="product-card-button">
                {% render 'product-card-button', product: product %}
              </div>
            </div>
          {% endcapture %}

          {% render 'product-card', product: product, children: product_card_content %}
        {%- else -%}
          <p>No products found in this collection.</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured collection",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_all_products",
      "label": "Show all products",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection Grid"
    }
  ],
  "blocks": [
    {
      "type": "judgeme_reviews",
      "name": "Judge.me Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_text",
          "label": "Show review text",
          "default": true
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ]
}
{% endschema %}
