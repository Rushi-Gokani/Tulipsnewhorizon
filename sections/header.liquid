<!-- ULTIMATE FIREFOX MENU FIX - Force close all details elements -->
<script>
  (function() {
    // Detect Firefox
    var isFirefox = typeof InstallTrigger !== 'undefined';
    
    if (isFirefox) {
      console.log('Firefox detected - applying ultimate menu fix');
      
      // Force close any open details elements
      function forceCloseAllDetails() {
        var allDetails = document.querySelectorAll('details');
        for (var i = 0; i < allDetails.length; i++) {
          if (allDetails[i].hasAttribute('open')) {
            allDetails[i].removeAttribute('open');
          }
        }
      }
      
      // Check every 50ms and close any details that shouldn't be open
      setInterval(function() {
        var allDetails = document.querySelectorAll('.header-menu details, .mega-menu details');
        for (var i = 0; i < allDetails.length; i++) {
          var details = allDetails[i];
          var parentItem = details.closest('.menu-list__item, .mega-menu');
          
          // If the parent is not being hovered, force close
          if (parentItem && !parentItem.matches(':hover')) {
            if (details.hasAttribute('open')) {
              details.removeAttribute('open');
              // Update ARIA
              var trigger = parentItem.querySelector('[aria-haspopup="true"]');
              if (trigger) trigger.setAttribute('aria-expanded', 'false');
            }
          }
        }
      }, 50);
      
      // Also close all details when mouse moves anywhere (fallback)
      function closeAllMenuDetails() {
        var allDetails = document.querySelectorAll('.header-menu details[open], .mega-menu details[open]');
        for (var i = 0; i < allDetails.length; i++) {
          allDetails[i].removeAttribute('open');
        }
      }

      document.addEventListener('mousemove', function(e) {
        var target = e.target;
        var isInMenu = target.closest('.menu-list__item, .mega-menu, .header-menu');

        if (!isInMenu) {
          closeAllMenuDetails();
        }
      });

      // Listen for pointer leaving the whole menu container and close menus
      var menus = document.querySelectorAll('.header-menu, .mega-menu');
      for (var m = 0; m < menus.length; m++) {
        (function(menu) {
          menu.addEventListener('pointerleave', function(e) {
            // When pointer leaves the menu entirely, close any open details
            var related = e.relatedTarget;
            if (!related || !menu.contains(related)) {
              closeAllMenuDetails();
            }
          });
        })(menus[m]);
      }

      // Add per-item handlers so leaving a specific menu item closes its details
      var menuItems = document.querySelectorAll('.header-menu .menu-list__item, .mega-menu');
      for (var i = 0; i < menuItems.length; i++) {
        (function(item) {
          // pointerleave: close details when pointer leaves the item entirely
          item.addEventListener('pointerleave', function(e) {
            var related = e.relatedTarget;
            if (!related || !item.contains(related)) {
              var details = item.querySelector('details[open]');
              if (details) {
                details.removeAttribute('open');
                var trigger = item.querySelector('[aria-haspopup="true"]');
                if (trigger) trigger.setAttribute('aria-expanded', 'false');
              }
            }
          });

          // focusout: keyboard users moving focus away should close menus
          item.addEventListener('focusout', function(e) {
            var related = e.relatedTarget;
            if (!related || !item.contains(related)) {
              var details = item.querySelector('details[open]');
              if (details) {
                details.removeAttribute('open');
                var trigger = item.querySelector('[aria-haspopup="true"]');
                if (trigger) trigger.setAttribute('aria-expanded', 'false');
              }
            }
          });
        })(menuItems[i]);
      }

      // Touch fallback: close menus when tapping outside
      document.addEventListener('touchstart', function(e) {
        var isInMenu = e.target.closest('.menu-list__item, .mega-menu, .header-menu');
        if (!isInMenu) closeAllMenuDetails();
      }, { passive: true });

      // Track last pointer position to help determine whether newly opened details are actually under the pointer
      var lastPointerPos = { x: -1, y: -1 };
      document.addEventListener('pointermove', function(e) {
        lastPointerPos.x = e.clientX;
        lastPointerPos.y = e.clientY;
      }, { passive: true });

      // MutationObserver: when a details element opens, ensure pointer is inside its parent; otherwise close it
      try {
        var detailsObserver = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            var target = m.target;
            if (target && target.tagName === 'DETAILS' && target.hasAttribute('open')) {
              // delay slightly to allow layout/content-visibility to settle
              setTimeout(function() {
                var px = lastPointerPos.x;
                var py = lastPointerPos.y;
                var underPointer = null;
                if (px >= 0 && py >= 0) {
                  underPointer = document.elementFromPoint(px, py);
                }

                var parentItem = target.closest('.menu-list__item, .mega-menu');
                var pointerInside = false;
                if (underPointer && parentItem) pointerInside = parentItem.contains(underPointer);

                if (!pointerInside) {
                  // close it if pointer isn't inside
                  if (target.hasAttribute('open')) {
                    target.removeAttribute('open');
                    var trigger = parentItem ? parentItem.querySelector('[aria-haspopup="true"]') : null;
                    if (trigger) trigger.setAttribute('aria-expanded', 'false');
                  }
                }
              }, 20);
            }
          });
        });

        // Observe attribute changes on the whole document subtree (filter inside callback)
        detailsObserver.observe(document, { subtree: true, attributes: true, attributeFilter: ['open'] });
      } catch (err) {
        // If MutationObserver fails, silently ignore — fallback handlers still exist
        console.warn('details observer unavailable', err);
      }

      // Per-`details` pointer handlers: schedule close after short delay to avoid Firefox race conditions
      (function() {
        var CLOSE_DELAY = 80;
        var detailsList = document.querySelectorAll('.header-menu details, .mega-menu details');
        for (var d = 0; d < detailsList.length; d++) {
          (function(details) {
            var closeTimer = null;
            function scheduleClose() {
              if (closeTimer) clearTimeout(closeTimer);
              closeTimer = setTimeout(function() {
                var parentItem = details.closest('.menu-list__item, .mega-menu');
                var parentHovered = parentItem && parentItem.matches(':hover');
                var detailsHovered = details.matches(':hover');
                if (!parentHovered && !detailsHovered) {
                  if (details.hasAttribute('open')) {
                    details.removeAttribute('open');
                    var trigger = parentItem ? parentItem.querySelector('[aria-haspopup="true"]') : null;
                    if (trigger) trigger.setAttribute('aria-expanded', 'false');
                  }
                }
              }, CLOSE_DELAY);
            }
            function cancelClose() { if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; } }

            details.addEventListener('pointerenter', cancelClose);
            details.addEventListener('pointerleave', scheduleClose);
            details.addEventListener('focusin', cancelClose);
            details.addEventListener('focusout', scheduleClose);

            var parent = details.closest('.menu-list__item');
            if (parent) {
              parent.addEventListener('pointerenter', cancelClose);
              parent.addEventListener('pointerleave', scheduleClose);
              parent.addEventListener('focusin', cancelClose);
              parent.addEventListener('focusout', scheduleClose);
            }
          })(detailsList[d]);
        }
      })();
      
      // Close on scroll
      window.addEventListener('scroll', function() {
        forceCloseAllDetails();
      });
      
      // Close on click
      document.addEventListener('click', function(e) {
        var isInMenu = e.target.closest('.menu-list__item, .mega-menu, .header-menu');
        if (!isInMenu) {
          forceCloseAllDetails();
        }
      });
    }
  })();
</script>

<!-- CRITICAL CSS FOR FIREFOX -->
<style>
  @-moz-document url-prefix() {
    /* Force all details elements to be position absolute so they don't affect layout */
    .header-menu details,
    .mega-menu details {
      position: absolute !important;
      top: 100% !important;
      left: 0 !important;
      background: var(--color-background) !important;
      z-index: 10000 !important;
    }
    
    /* Ensure menu items have proper positioning */
    .menu-list__item,
    .mega-menu {
      position: relative !important;
    }
    
    /* Force hide any open details whose parent isn't hovered */
    .menu-list__item:not(:hover) details[open],
    .mega-menu:not(:hover) details[open] {
      display: none !important;
    }
  }
</style>

