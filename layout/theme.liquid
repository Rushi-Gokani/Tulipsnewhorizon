<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <!-- DNS Prefetch - Keep these early for performance -->
    <link rel="dns-prefetch" href="https://pdp.gokwik.co/">
    <link rel="dns-prefetch" href="https://api.gokwik.co">
    <link rel="dns-prefetch" href="https://connect.facebook.net">
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    
    <!-- Resource hints for critical domains -->
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

    <!-- Gokwik theme code start -->
    {% render 'gokwik' %}
    <!-- Gokwik theme code End -->

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <meta name="google-site-verification" content="-eSE3nFVgthK2DXrQMqZTrOOozFqr_QE9I4Mra6ti48" />
    
    <!-- Optimized Header Calculations -->
    <script>
      (function() {
        // Use requestAnimationFrame to avoid blocking render
        var rafScheduled = false;
        
        function setHeaderProperties() {
          if (rafScheduled) return;
          rafScheduled = true;
          
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              var header = document.querySelector('header-component');
              var headerGroup = document.querySelector('#header-group');
              
              if (!header || !headerGroup) {
                rafScheduled = false;
                return;
              }
              
              // Batch all DOM reads first
              var headerHeight = header.offsetHeight;
              var headerGroupHeight = 0;
              var children = headerGroup.children;
              
              for (var i = 0; i < children.length; i++) {
                var element = children[i];
                if (element !== header && element instanceof HTMLElement) {
                  headerGroupHeight += element.offsetHeight;
                }
              }
              
              if (header.hasAttribute('transparent') && header.parentElement && header.parentElement.nextElementSibling) {
                headerGroupHeight += headerHeight;
              }
              
              var hasHeaderSection = headerGroup.querySelector('.header-section');
              var transparentOffset = '0';
              
              if (hasHeaderSection && header.hasAttribute('transparent')) {
                var nextSection = hasHeaderSection.nextElementSibling;
                var hasImmediateSection = nextSection && nextSection.classList.contains('shopify-section');
                transparentOffset = hasImmediateSection ? '0' : '1';
              }
              
              var isTouchDevice = ('ontouchstart' in window) && (navigator.maxTouchPoints > 0);
              var overflowList = header.querySelector('overflow-list');
              var hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
              var menuStyle = (isTouchDevice || hasReachedMinimum) ? 'drawer' : 'menu';
              
              // Batch all DOM writes
              document.body.style.setProperty('--header-height', headerHeight + 'px');
              document.body.style.setProperty('--header-group-height', headerGroupHeight + 'px');
              document.body.style.setProperty('--transparent-header-offset-boolean', transparentOffset);
              header.dataset.menuStyle = menuStyle;
              
              rafScheduled = false;
            });
          });
        }
        
        // Initial calculation
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setHeaderProperties);
        } else {
          setHeaderProperties();
        }
        
        // Recalculate on resize with debounce
        var resizeTimer;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(setHeaderProperties, 100);
        });
      })();
    </script>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <!-- Move theme scripts to bottom -->
    {%- render 'scripts' -%}

    <!-- Gokwik Checkout Handler -->
    <script>
      function onCheckoutNow(e) {
        var dialog = document.querySelector('.cart-drawer dialog');
        if (dialog && dialog.hasAttribute('open')) {
          var cart = document.querySelector('.cart-drawer');
          if (cart && typeof cart.close === 'function') {
            cart.close();
            setTimeout(function() {
              if (typeof onCheckoutClick === 'function') {
                onCheckoutClick(e);
              }
            }, 150);
            return;
          }
        }
        if (typeof onCheckoutClick === 'function') {
          onCheckoutClick(e);
        }
      }
    </script>

    <!-- Gokwik AddToCart Manual Trigger -->
    <script>
      document.addEventListener('click', function(e) {
        var gokwikBtn = e.target.closest('[data-gokwik]');
        if (!gokwikBtn) return;
        
        if (typeof fbq !== 'undefined' && typeof fbq === 'function') {
          fbq('track', 'AddToCart', {
            value: {{ product.price | default: 0 | money_without_currency | remove: ',' }},
            currency: 'INR'
          });
        }
      });
    </script>

    <!-- Deferred Third-Party Scripts -->
    <script>
      (function() {
        // Load scripts only when page is idle or after 3 seconds
        var loadThirdParty = function() {
          // Google Analytics
          var gtagScript = document.createElement('script');
          gtagScript.async = true;
          gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-H09HCRV29Y';
          gtagScript.onload = function() {
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-H09HCRV29Y');
          };
          document.body.appendChild(gtagScript);

          // Facebook Pixel - delay by 2 seconds
          setTimeout(function() {
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '1369748547906522');
            fbq('track', 'PageView');
          }, 2000);
        };

        // Use requestIdleCallback if available, otherwise setTimeout
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadThirdParty, { timeout: 3000 });
        } else {
          setTimeout(loadThirdParty, 3000);
        }
      })();
    </script>

    <!-- Facebook Pixel Noscript Fallback -->
    <noscript>
      <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=1369748547906522&ev=PageView&noscript=1"
      />
    </noscript>
  </body>
</html>